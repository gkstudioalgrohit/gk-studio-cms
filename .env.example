# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings → Environment Variables instead.

# --- Database (required) ---
# A PostgreSQL connection string. Free tier: Neon (neon.tech) — see README.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- File storage (required for uploads) ---
# From Vercel: Project → Storage → Create Database → Blob → copy the token.
# Free tier: 1 GB storage / 10 GB bandwidth per month (Hobby plan, as of writing).
BLOB_READ_WRITE_TOKEN=

# --- Public site URL (used for SEO tags and the sitemap) ---
NEXT_PUBLIC_SITE_URL=https://gkstudio.co.in

# --- First admin account (optional convenience) ---
# If set, the build automatically creates this admin account the first time
# it runs against an empty database. Remove these two lines after your first
# deploy — you don't need them again (create more admins with `npm run create-admin`
# or by asking an existing admin to update accounts).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Local development only ---
# Lets file uploads save to disk instead of Vercel Blob when no token is set.
# Do NOT set this in production — Vercel's filesystem is temporary.
GK_ALLOW_LOCAL_STORAGE=1
